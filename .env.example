# Copy to .env for local use, or paste these into Dokploy's environment panel.
#
# There is very little here on purpose. The app has no database, no accounts and
# no third-party services - the course is read from files baked into the image,
# so there is nothing to configure and nothing to leak.

# Port the container listens on. Dokploy routes to this.
PORT=8000

# Host port for docker-compose locally. 8000 is already taken on this machine.
APP_PORT=8011


# --- Not needed yet, listed so nobody wonders where they went ----------------
# DATABASE_URL        arrives with accounts and progress tracking
# SECRET_KEY          arrives with login
# ANTHROPIC_API_KEY   only if the site ever calls a model itself; it does not today
